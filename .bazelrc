# Set Python version to 3.13 to match bazel-orfs requirements
build --@rules_python//python/config_settings:python_version=3.13

# Required by OpenROAD (STA uses std::format_string from C++20)
build --cxxopt "-std=c++20" --host_cxxopt "-std=c++20"

# Set for toolchains_riscv_gnu
build --incompatible_enable_cc_toolchain_resolution
build --incompatible_disallow_empty_glob=false

build --incompatible_strict_action_env
common --lockfile_mode=off

# Required by OpenROAD's MODULE.bazel (uses isolate = True in use_extension)
common --experimental_isolated_extension_usages

# Build OpenROAD from source with GUI enabled to match the docker image.
# Use: bazelisk build --config=openroad-gui @openroad//:openroad
build:openroad-gui --@openroad//:platform=gui

# Garbage-collect disk cache to avoid exhausting CI runner disk.
build --experimental_disk_cache_gc_max_size=2G

try-import %workspace%/user.bazelrc
