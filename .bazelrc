# Enable experimental isolated extension usages for Bzlmod (required for some openroad features)
common --experimental_isolated_extension_usages

# Set Python version to 3.13 to match bazel-orfs requirements
build --@rules_python//python/config_settings:python_version=3.13

build --cxxopt "-std=c++20" --host_cxxopt "-std=c++20"

# Set for toolchains_riscv_gnu
build --incompatible_enable_cc_toolchain_resolution
build --incompatible_disallow_empty_glob=false
